# PostgreSQL local (Docker, porta 5433 para evitar conflito com PG nativo na 5432)
DATABASE_URL=postgresql://finance:finance@localhost:5433/finance?schema=public

# Neon (produção, na fase de deploy):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/finance?sslmode=require

# API — apps/api/.env
PORT=4000
JWT_ACCESS_SECRET=troque-por-um-segredo-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
WEB_APP_URL=http://localhost:3000

# Web — apps/web/.env
NEXT_PUBLIC_API_URL=http://localhost:4000
